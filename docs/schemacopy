-- Default color options for all products
DO $$
DECLARE
    prod_id UUID;
    color_names TEXT[] := ARRAY['Black', 'White', 'Navy Blue', 'Red', 'Heather Gray', 'Royal Blue', 'Forest Green', 'Maroon', 'Purple', 'Orange'];
    color_name TEXT;
    color_order INTEGER := 1;
BEGIN
    FOR prod_id IN SELECT id FROM products LOOP
        color_order := 1;
        FOREACH color_name IN ARRAY color_names LOOP
            INSERT INTO product_options (product_id, option_type, option_value, display_order) 
            VALUES (prod_id, 'color', color_name, color_order);
            color_order := color_order + 1;
        END LOOP;
    END LOOP;
END $$;

