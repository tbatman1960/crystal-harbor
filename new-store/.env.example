# Public canonical URL; no trailing slash. Also used for origin checks and Stripe redirects.
SITE_URL=http://localhost:3000
# Supabase project URL and public anon key (safe for browser use; RLS is mandatory).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only: database administrative integration key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Stripe secret key: use sk_test_ for testing, sk_live_ for production.
STRIPE_SECRET_KEY=sk_test_replace_me
# Signing secret for this environment's Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional legacy carrier-rate module only; fixed product shipping does not use these.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
# Production USPS API base. Use https://apis-tem.usps.com for USPS testing.
USPS_API_BASE_URL=https://apis.usps.com
# Resend API key and a sender address on a verified domain.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=SnuggleBug <orders@your-verified-domain.com>
# Random 32+ character bearer token protecting email retry and reconciliation job.
CRON_SECRET=replace-with-a-long-random-secret

# Optional, server only: Google Places API (New) and Address Validation API key.
# Enable both APIs and billing in Google Cloud; restrict this key to those APIs.
# Street suggestions/USPS delivery validation are optional; state/ZIP lookup works without it.
GOOGLE_MAPS_API_KEY=

# SMTP alternative: reuse the original site's existing Production variables.
# SMTP takes priority when SMTP_HOST is set; Resend is then optional.
SMTP_HOST=
# Usually 587 (STARTTLS) or 465 (implicit TLS).
SMTP_PORT=587
SMTP_USER=
# Server-only secret: SMTP password or provider app password.
SMTP_PASS=
# Optional: true for 465, false for STARTTLS; defaults from port when omitted.
SMTP_SECURE=
# Authorized sender; defaults to store name and store email if omitted.
SMTP_FROM=

# AI-illustrated blanket preview: server-only values, preferably Deploy Previews context only.
# OpenAI API project key; API billing is separate from ChatGPT. Mark as secret.
OPENAI_API_KEY=
# Explicitly enable billable image generation after setting the API key and budget.
AI_ILLUSTRATION_ENABLED=false
# Image-edit model, currently documented for reference-image editing.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Global generation attempts per UTC day; defaults to 10 and is capped at 100.
AI_ILLUSTRATION_DAILY_LIMIT=10
# Preview Stripe payments still need sk_test_ and that preview endpoint's whsec_ values.
